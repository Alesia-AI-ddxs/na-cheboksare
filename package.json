{
  "name": "na-cheboksare",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/noto-naskh-arabic": "^0.4.5",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.1",
    "@expo-google-fonts/noto-sans-hk": "^0.4.4",
    "@expo-google-fonts/noto-sans-sc": "^0.4.4",
    "@expo-google-fonts/noto-sans-tc": "^0.4.4",
    "@expo-google-fonts/prata": "^0.4.1",
    "@expo-google-fonts/pt-sans": "^0.4.1",
    "@formatjs/intl-pluralrules": "^6.3.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.18",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "i18next": "^26.5.4",
    "i18next-icu": "^2.6.1",
    "intl-messageformat": "^12.1.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eas-cli": "^25.3.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check": "tsc --noEmit && node scripts/validate-content.mjs",
    "web:export": "expo export --platform web && node scripts/postexport-pwa.mjs",
    "eas:init": "eas init",
    "eas:preview": "eas build -p android --profile preview",
    "eas:release-ru": "eas workflow:run .eas/workflows/release-ru-stores.yml",
    "icons": "node scripts/make-icons.mjs && node scripts/make-pwa-icons.mjs",
    "qa:screens": "node scripts/qa-screens.mjs",
    "web:export:turizm": "node scripts/export-web.mjs /turizm/app",
    "pwa:check": "node scripts/pwa-offline-check.mjs",
    "eas:preview:ios": "eas build -p ios --profile preview",
    "eas:apk": "eas build -p android --profile preview",
    "eas:release-gp": "eas workflow:run .eas/workflows/release-google-play.yml",
    "stores:rustore": "node scripts/rustore-publish.mjs",
    "stores:appgallery": "node scripts/appgallery-publish.mjs",
    "stores:doctor": "node scripts/stores-doctor.mjs",
    "stores:ios-config": "node scripts/ios-submit-config.mjs",
    "test:publish": "node --test tests/publish-mock.test.mjs",
    "release:rustore": "eas workflow:run .eas/workflows/release-ru-stores.yml -F stores=rustore -F submit=no",
    "release:ru-all": "eas workflow:run .eas/workflows/release-ru-stores.yml -F stores=rustore+appgallery -F submit=no",
    "qa:plural": "node scripts/plural-check.mjs",
    "qa:tofu": "python3 -I tools/tofu_check.py"
  },
  "private": true
}
