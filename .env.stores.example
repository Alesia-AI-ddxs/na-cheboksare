# Ключи для публикации «На Чебоксаре» в магазины приложений.
# КАК ПОЛЬЗОВАТЬСЯ: скопируйте этот файл в .env.stores (рядом) и впишите свои значения.
# Файл .env.stores НЕ попадает в git (он в .gitignore). Никому его не пересылайте.
# Проверка, всё ли заполнено: npm run stores:doctor
# Для облачных сборок EAS эти же имена заводятся в expo.dev → проект → Environment variables (среда production, тип «Secret»).

# ===================== RuStore =====================
# Где взять: console.rustore.ru → Компания (вверху) → API RuStore → «Сгенерировать ключ».
# Отметьте доступ к приложению «На Чебоксаре» и методы «Публикация».
# Консоль покажет ID ключа и приватный ключ — приватный ключ показывается ОДИН РАЗ, сохраните сразу.
RUSTORE_KEY_ID=
# Приватный ключ одной строкой (base64, как его выдаёт консоль RuStore), без кавычек и переносов.
RUSTORE_PRIVATE_KEY=
# Тип публикации после модерации: MANUAL — вы сами нажимаете «Опубликовать» (по умолчанию, безопаснее),
# INSTANTLY — сразу после модерации, DELAYED — по дате из консоли.
RUSTORE_PUBLISH_TYPE=MANUAL
# Текст «Что нового» (необязательно; если пусто — берётся первый раздел CHANGELOG.md).
RUSTORE_WHATS_NEW=
# Приоритет обновления 0–5 (необязательно).
RUSTORE_PRIORITY_UPDATE=

# ===================== Huawei AppGallery =====================
# Где взять ключ: developer.huawei.com → AppGallery Connect → Пользователи и разрешения (Users and permissions)
# → API-ключ (API key) → Connect API → «Создать», роль «Администратор» (Administrator).
AGC_CLIENT_ID=
AGC_CLIENT_SECRET=
# ID приложения: AppGallery Connect → Мои приложения → «На Чебоксаре» → Информация о приложении → App ID.
# (Приложение сначала создаётся в консоли вручную, один раз.)
AGC_APP_ID=

# ===================== Google Play =====================
# Здесь переменных нет: нужен ФАЙЛ ./secrets/google-play-service-account.json
# Где взять: Google Cloud Console → IAM → Сервисные аккаунты → создать → Ключи → «Добавить ключ» → JSON;
# затем Play Console → Пользователи и разрешения → пригласить e-mail сервисного аккаунта с правом выпуска.
# ВАЖНО: самый первый AAB в Google Play загружается руками через Play Console, дальше — npm run eas:release-gp.

# ===================== Apple App Store (позже, когда будет аккаунт) =====================
# Нужен платный аккаунт Apple Developer Program (оформляется на ИП).
# ASC_APP_ID — App Store Connect → Приложения → «На Чебоксаре» → Информация о приложении → Apple ID (число).
ASC_APP_ID=
# APPLE_TEAM_ID — developer.apple.com → Account → Membership details → Team ID (10 символов).
APPLE_TEAM_ID=
# После заполнения: npm run stores:ios-config (впишет их в eas.json), затем npx eas credentials -p ios.
